<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- lets the Shortcuts card (方方查詞（小視窗）) play recordings while another app is on screen -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>edrdg.org</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- fangfangcards://safari?ops=…: the words saved in Safari 查詞 (its 傳到 App button) -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Safari 查詞</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>fangfangcards</string>
			</array>
		</dict>
	</array>
	<!-- the App Group shared with the 分類詞卡 widget -->
	<key>FFAppGroup</key>
	<string>$(APP_GROUP)</string>
</dict>
</plist>
