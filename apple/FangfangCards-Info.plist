<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- lets the Shortcuts card (方方查詞（小視窗）) play recordings while another app is on screen -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoadsForMedia</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>edrdg.org</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>kth.se</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
	<!-- 找歌來聽: whole songs from Apple Music (asked once; without it, 30-second previews) -->
	<key>NSAppleMusicUsageDescription</key>
	<string>用 Apple Music 播整首歌，歌詞跟著歌走。Plays whole songs with Apple Music so the lyrics follow them.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- fangfangcards://safari?ops=…: the words saved in Safari 查詞 (its 傳到 App button) -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>Safari 查詞</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>fangfangcards</string>
			</array>
		</dict>
	</array>
	<!-- 一起玩: finding the other players nearby (the same Wi-Fi or Bluetooth) -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>找附近一起玩的人（同一個 Wi-Fi 或藍牙）。Finds the people nearby to play with (the same Wi-Fi or Bluetooth).</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_ff-coop._tcp</string>
		<string>_ff-coop._udp</string>
	</array>
	<!-- 動態島: a 不熟 word in the Dynamic Island while you're away from the app (iPhone) -->
</dict>
</plist>
