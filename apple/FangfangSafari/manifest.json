{
    "manifest_version": 3,
    "name": "方方詞卡 查詞",
    "description": "Hover over a word with the Apple Pencil (or a trackpad) to see it in the dictionaries of 方方詞卡, and send it to the app. On YouTube and Viki, the video's subtitles in a panel beside it.",
    "version": "1.58",
    "icons": {
        "48": "icon-48.png",
        "64": "icon-64.png",
        "96": "icon-96.png",
        "128": "icon-128.png",
        "256": "icon-256.png",
        "512": "icon-512.png"
    },
    "action": {
        "default_title": "方方詞卡 查詞",
        "default_popup": "popup.html",
        "default_icon": {
            "48": "icon-48.png",
            "64": "icon-64.png",
            "96": "icon-96.png",
            "128": "icon-128.png"
        }
    },
    "background": {
        "scripts": [
            "datastore.js",
            "background.js"
        ],
        "type": "module"
    },
    "content_scripts": [
        {
            "js": [
                "subs-page.js"
            ],
            "matches": [
                "*://*.youtube.com/*",
                "*://*.viki.com/*"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "js": [
                "ui-en.js",
                "content.js"
            ],
            "matches": [
                "<all_urls>"
            ],
            "run_at": "document_idle"
        }
    ],
    "permissions": [
        "storage",
        "unlimitedStorage"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "subs-page.js"
            ],
            "matches": [
                "*://*.youtube.com/*",
                "*://*.viki.com/*"
            ]
        }
    ],
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "fangfang-lookup@unoki99",
            "strict_min_version": "140.0",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        },
        "gecko_android": {
            "strict_min_version": "142.0"
        }
    },
    "optional_host_permissions": [
        "http://127.0.0.1/*"
    ],
    "host_permissions": [
        "https://raw.githubusercontent.com/*",
        "https://sutian.moe.edu.tw/*",
        "https://hakkadict.moe.edu.tw/*",
        "https://kaikki.org/*",
        "http://folkets-lexikon.csc.kth.se/*"
    ]
}
